APP_NAME="Codebase Time Machine"
APP_ENV=development
DEBUG=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codebase_time_machine
# Docker service names; change these to localhost when running Python on host.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/codebase_time_machine
REDIS_URL=redis://redis:6379/0
REPOSITORY_STORAGE_PATH=/data/repositories
GITHUB_TOKEN=
MAX_GITHUB_PULL_REQUESTS=500
MAX_GITHUB_ISSUES=1000
MAX_GITHUB_COMMENTS=5000
MAX_GITHUB_REVIEW_COMMENTS=5000
MAX_GITHUB_BODY_LENGTH=200000
GITHUB_REQUEST_TIMEOUT_SECONDS=15
GITHUB_MAX_RETRIES=3
MAX_GRAPH_NODES=50000
MAX_GRAPH_EDGES=200000
MAX_GRAPH_RESPONSE_NODES=500
MAX_GRAPH_DEPTH=5
MAX_CALL_RESOLUTION_CANDIDATES=20
MAX_FILES_PER_COMMIT_FOR_COUPLING=100
MAX_GRAPH_BUILD_TIME_SECONDS=900
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=
OLLAMA_EMBEDDING_MODEL=
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_HEALTH_TIMEOUT_SECONDS=3
AI_EMBEDDING_BATCH_SIZE=16
RAG_TOP_K_VECTOR=12
RAG_TOP_K_LEXICAL=12
RAG_TOP_K_FINAL=12
RAG_MAX_CONTEXT_CHARS=4000
RAG_MAX_EVIDENCE_ITEMS=6
RAG_MAX_DIFF_CHARS=8000
MAX_EMBEDDING_CHUNK_CHARS=5000
MAX_DIFF_EMBEDDING_CHUNKS_PER_COMMIT=20
AI_MAX_EVIDENCE_DOCUMENTS=12000
AI_MAX_DIFF_COMMITS=250
AI_MAX_ANSWER_CHARS=12000
AI_DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
MAX_REPOSITORY_SIZE_MB=500
MAX_COMMITS=10000
MAX_FILES=50000
MAX_FILE_SIZE_BYTES=2000000
MAX_DIFF_SIZE_BYTES=500000
MAX_SOURCE_FILE_SIZE_BYTES=1000000
MAX_REPOSITORY_FILES=50000
MAX_PARSE_TIME_PER_FILE_SECONDS=2
MAX_HISTORY_COMMITS=2000
MAX_HISTORICAL_FILES=20000
MAX_HISTORICAL_SYMBOL_SOURCE_BYTES=100000
MAX_HISTORY_INDEX_TIME_SECONDS=900
MAX_BLAME_LINES=500
ARCHAEOLOGY_RECENT_DAYS=180
SYMBOL_REWRITE_SIMILARITY_THRESHOLD=0.50
MAX_ARCHAEOLOGY_FILES=20000
MAX_ARCHAEOLOGY_SYMBOLS=50000
MAX_COPY_CANDIDATES_PER_SYMBOL=10
MAX_REWRITE_COMPARISONS=100000
MAX_ARCHAEOLOGY_SEARCH_RESULTS=100
MAX_ARCHAEOLOGY_BUILD_SECONDS=900
ARCHITECTURE_SNAPSHOT_STRATEGY=adaptive
ARCHITECTURE_SNAPSHOT_INTERVAL_COMMITS=25
MAX_ARCHITECTURE_SNAPSHOTS=500
MAX_HISTORICAL_GRAPH_NODES=5000
MAX_HISTORICAL_GRAPH_EDGES=20000
MAX_ARCHITECTURE_HISTORY_COMMITS=2000
MAX_ARCHITECTURE_HISTORY_BUILD_SECONDS=900
ARCHITECTURE_RULE_MIN_EDGE_CONFIDENCE=0.8
SYMBOL_MATCH_THRESHOLD=0.86
SYMBOL_RENAME_MATCH_THRESHOLD=0.9
TASK_EXECUTION_MODE=local
CLONE_TIMEOUT_SECONDS=300
FETCH_TIMEOUT_SECONDS=180
GIT_COMMAND_TIMEOUT_SECONDS=60
GIT_OUTPUT_LIMIT_BYTES=16777216
